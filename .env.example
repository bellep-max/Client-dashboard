# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/aeo_platform

# ─── Session ──────────────────────────────────────────────────────────────────
# Secret used to sign session cookies — use a long random string in production
SESSION_SECRET=replace_with_a_long_random_secret

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
# Publishable key from your Clerk dashboard (required for the frontend)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Optional: Clerk proxy URL for custom domain setups
# VITE_CLERK_PROXY_URL=https://your-domain.com/clerk
